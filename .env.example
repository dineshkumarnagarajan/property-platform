# Environment
NODE_ENV=development
PORT=3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=propertyplatform
DB_USER=pp_user
DB_PASSWORD=pp_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=property_platform_jwt_secret_min32chars_required
JWT_EXPIRES_IN=7d

# WordPress GraphQL Endpoint
WP_GRAPHQL_URL=https://demo.wpgraphql.com/graphql

# CRM Webhook Secret (HMAC)
CRM_WEBHOOK_SECRET=crm_hmac_secret_here_min32chars

# Cache TTLs (seconds)
CACHE_TTL_ENQUIRY=60
CACHE_TTL_WP_PROPERTIES=300